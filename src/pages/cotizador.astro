---
import '../styles/tokens.css';
import '../styles/price.css';
import { CotizadorRedesign } from '../components/services/CotizadorRedesign';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/cotizador/favicon.svg" />
    <link rel="apple-touch-icon" href="/cotizador/favicon.svg" />
    <meta name="theme-color" content="#0b0a09" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>Cotizador de proyectos 3D — Alexander Woodcock</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Cotizador de proyectos 3D — Alexander Woodcock" />
    <meta property="og:description" content="Rango orientativo de costo y tiempo para tus proyectos 3D interactivos, en segundos." />
    <meta property="og:url" content="https://services.alexwoodcock.me/cotizador/" />
    <meta property="og:image" content="https://services.alexwoodcock.me/cotizador/og.jpg" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cotizador de proyectos 3D — Alexander Woodcock" />
    <meta name="twitter:description" content="Rango orientativo de costo y tiempo para tus proyectos 3D interactivos." />
    <meta name="twitter:image" content="https://services.alexwoodcock.me/cotizador/og.jpg" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Desarrollo 3D web en tiempo real",
      "provider": { "@type": "Person", "name": "Alexander Woodcock", "url": "https://alexwoodcock.me/" },
      "areaServed": "Worldwide",
      "serviceType": "Real-time 3D web development",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "COP",
        "lowPrice": "400000",
        "highPrice": "12610000",
        "offerCount": "28"
      }
    }
    </script>
    <meta name="description" content="Rango orientativo de costo y tiempo para tus proyectos 3D." />
    <script is:inline>
      /* Tema ANTES del primer pintado (evita flash blanco en modo oscuro). */
      try {
        var t = localStorage.getItem('cx-theme');
        if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.cxTheme = t;
        document.documentElement.style.background = t === 'dark' ? '#0b0a09' : '#f7f5f0';
      } catch (e) { /* sin almacenamiento */ }
    </script>
    <style is:global>
      html { background: #f7f5f0; }
      html[data-cx-theme='dark'] { background: #0b0a09; }
      /* Ciclo 10 — refuerzo del fondo SIN JS a nivel body: el inline claro es el
         default de SSR; en oscuro la regla !important lo corrige ANTES de que la
         isla hidrate (el inline pierde contra !important). */
      html[data-cx-theme='light'] body { background: #f7f5f0 !important; }
      html[data-cx-theme='dark'] body { background: #0b0a09 !important; }
      /* Vars de tema a nivel documento: nunca dependen de la hidratación del isla */
      html[data-cx-theme='light'] {
        --cx-bg: #f7f5f0; --cx-card: rgba(255,255,255,0.78); --cx-card-solid: #ffffff;
        --cx-tile: #efece5; --cx-text: #17150f; --cx-muted: #6b665c; --cx-faint: #9c968a;
        --cx-border: rgba(23,21,15,0.08); --cx-border-strong: rgba(23,21,15,0.16); --cx-soft: rgba(23,21,15,0.06);
        --cx-accent: #c2410c; --cx-accent-hover: #9a3412; --cx-accent-soft: rgba(234,88,12,0.10);
        --cx-accent-border: rgba(194,65,12,0.32);
        --cx-shadow-card: 0 1px 2px rgba(23,21,15,0.04), 0 8px 24px -12px rgba(23,21,15,0.10); --cx-shadow-hover: 0 2px 4px rgba(23,21,15,0.05), 0 18px 40px -18px rgba(194,65,12,0.35);
        --cx-shadow-knob: 0 2px 8px rgba(23,21,15,0.18); --cx-obj-shadow: rgba(23,21,15,0.14);
      }
      html[data-cx-theme='dark'] {
        --cx-bg: #0b0a09; --cx-card: rgba(24,22,20,0.72); --cx-card-solid: #191715;
        --cx-tile: #24211e; --cx-text: #f4f1ea; --cx-muted: #a59f94; --cx-faint: #6f6a61;
        --cx-border: rgba(244,241,234,0.08); --cx-border-strong: rgba(244,241,234,0.16); --cx-soft: rgba(244,241,234,0.10);
        --cx-accent: #ff7a3d; --cx-accent-hover: #ff9566; --cx-accent-soft: rgba(255,122,61,0.13);
        --cx-accent-border: rgba(255,122,61,0.38);
        --cx-shadow-card: 0 1px 0 rgba(255,255,255,0.03) inset, 0 12px 32px -16px rgba(0,0,0,0.7); --cx-shadow-hover: 0 1px 0 rgba(255,255,255,0.05) inset, 0 24px 48px -20px rgba(255,122,61,0.30);
        --cx-shadow-knob: 0 2px 8px rgba(0,0,0,0.6); --cx-obj-shadow: rgba(0,0,0,0.65);
      }
    </style>
  </head>
  <body style="margin:0; font-family:-apple-system,'Segoe UI',Inter,system-ui,sans-serif; background:#f7f5f0;">
    <CotizadorRedesign client:load />
  </body>
</html>

---
import '../styles/tokens.css';
import '../styles/price.css';
import { CotizadorRedesign } from '../components/services/CotizadorRedesign';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/cotizador/favicon.svg" />
    <link rel="apple-touch-icon" href="/cotizador/favicon.svg" />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>Cotizador de proyectos 3D — Alex Woodcock</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Cotizador de proyectos 3D — Alex Woodcock" />
    <meta property="og:description" content="Rango orientativo de costo y tiempo para tus proyectos 3D interactivos, en segundos." />
    <meta property="og:url" content="https://services.alexwoodcock.me/cotizador/" />
    <meta property="og:image" content="https://services.alexwoodcock.me/cotizador/og.jpg" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cotizador de proyectos 3D — Alex Woodcock" />
    <meta name="twitter:description" content="Rango orientativo de costo y tiempo para tus proyectos 3D interactivos." />
    <meta name="twitter:image" content="https://services.alexwoodcock.me/cotizador/og.jpg" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Desarrollo 3D web en tiempo real",
      "provider": { "@type": "Person", "name": "Alex Woodcock", "url": "https://alexwoodcock.me/" },
      "areaServed": "Worldwide",
      "serviceType": "Real-time 3D web development",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "COP",
        "lowPrice": "400000",
        "highPrice": "12610000",
        "offerCount": "28"
      }
    }
    </script>
    <meta name="description" content="Rango orientativo de costo y tiempo para tus proyectos 3D." />
    <script is:inline>
      /* Ciclo 32 — pantalla de inicio: se decide ANTES del primer pintado (sin destello de la página).
         Sin intro si el usuario pidió menos movimiento o vuelve con el historial a un paso del wizard. */
      try {
        var hs = history.state;
        var back = hs && hs.cx === 'cotizador' && (hs.level > 1 || hs.config);
        /* ?intro=0 abre directo en el hero (QA y enlaces directos) */
        if (/[?&]intro=0(&|$)/.test(location.search)) back = true;
        if (!back && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) document.documentElement.dataset.cxIntro = 'pre';
      } catch (e) { /* sin intro */ }
      /* red de seguridad: si la isla no llega a montar, nunca dejar la página a oscuras */
      setTimeout(function () { var d = document.documentElement.dataset; if (d.cxIntro === 'pre') delete d.cxIntro; }, 4000);
    </script>
    <script is:inline>
      /* Tema ANTES del primer pintado (evita flash blanco en modo oscuro). */
      try {
        var t = localStorage.getItem('cx-theme');
        if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.cxTheme = t;
        document.documentElement.style.background = t === 'dark' ? '#0a0b0d' : '#f4f6f9';
      } catch (e) { /* sin almacenamiento */ }
    </script>
    <style is:global>
      html { background: #f4f6f9; }
      html[data-cx-theme='dark'] { background: #0a0b0d; --cx-bg: #0a0b0d; --cx-card: rgba(20,22,26,0.78); --cx-card-solid: #14161a; --cx-tile: #1c1f24; --cx-text: #f2f3f5; --cx-muted: #9aa1ab; --cx-faint: #6c737e; --cx-border: rgba(242,243,245,0.08); --cx-border-strong: rgba(242,243,245,0.16); --cx-soft: rgba(242,243,245,0.08); --cx-accent: #ff7a3d; --cx-accent-hover: #ff9566; --cx-accent-soft: rgba(255,122,61,0.12); --cx-accent-border: rgba(255,122,61,0.38); --cx-shadow-card: 0 1px 0 rgba(242,243,245,0.03) inset, 0 12px 32px -16px rgba(0,0,0,0.8); --cx-shadow-hover: 0 1px 0 rgba(242,243,245,0.05) inset, 0 24px 48px -22px rgba(255,122,61,0.30); --cx-shadow-knob: 0 2px 8px rgba(0,0,0,0.6); --cx-obj-shadow: rgba(0,0,0,0.7); --cx-on-accent: #1a0a02; --cx-accent-2: #ffb547; --cx-signal: #67d4ff; --cx-signal-soft: rgba(103,212,255,0.10); --cx-glow: rgba(255,122,61,0.11); --cx-glow-2: rgba(103,212,255,0.06); --cx-grid: rgba(242,243,245,0.04);
        
        }
      /* Ciclo 10 — refuerzo del fondo SIN JS a nivel body: el inline claro es el
         default de SSR; en oscuro la regla !important lo corrige ANTES de que la
         isla hidrate (el inline pierde contra !important). */
      html[data-cx-theme='light'] body { background: #f4f6f9 !important; }
      html[data-cx-theme='dark'] body { background: #0a0b0d !important; }
      /* Vars de tema a nivel documento: nunca dependen de la hidratación del isla */
      html[data-cx-theme='light'] {
        --cx-bg: #f4f6f9; --cx-card: rgba(255,255,255,0.86); --cx-card-solid: #ffffff;
        --cx-tile: #eaeef3; --cx-text: #0e1726; --cx-muted: #556070; --cx-faint: #8792a2;
        --cx-border: rgba(14,23,38,0.09); --cx-border-strong: rgba(14,23,38,0.17); --cx-soft: rgba(14,23,38,0.06);
        --cx-accent: #c4400d; --cx-accent-hover: #a3350a; --cx-accent-soft: rgba(196,64,13,0.09);
        --cx-accent-border: rgba(196,64,13,0.30);
        --cx-shadow-card: 0 1px 2px rgba(14,23,38,0.05), 0 10px 28px -14px rgba(14,23,38,0.14); --cx-shadow-hover: 0 2px 4px rgba(14,23,38,0.05), 0 20px 44px -20px rgba(196,64,13,0.38);
        --cx-shadow-knob: 0 2px 8px rgba(14,23,38,0.18); --cx-obj-shadow: rgba(14,23,38,0.16); --cx-on-accent: #ffffff; --cx-accent-2: #f59e0b; --cx-signal: #0369a1; --cx-signal-soft: rgba(3,105,161,0.08); --cx-glow: rgba(196,64,13,0.09); --cx-glow-2: rgba(3,105,161,0.07); --cx-grid: rgba(14,23,38,0.045);
        
        }
      html[data-cx-theme='dark'] {
        --cx-bg: #0a0b0d; --cx-card: rgba(24,22,20,0.72); --cx-card-solid: #191715;
        --cx-tile: #24211e; --cx-text: #f4f1ea; --cx-muted: #a59f94; --cx-faint: #6f6a61;
        --cx-border: rgba(244,241,234,0.08); --cx-border-strong: rgba(244,241,234,0.16); --cx-soft: rgba(244,241,234,0.10);
        --cx-accent: #ff7a3d; --cx-accent-hover: #ff9566; --cx-accent-soft: rgba(255,122,61,0.13);
        --cx-accent-border: rgba(255,122,61,0.38);
        --cx-shadow-card: 0 1px 0 rgba(255,255,255,0.03) inset, 0 12px 32px -16px rgba(0,0,0,0.7); --cx-shadow-hover: 0 1px 0 rgba(255,255,255,0.05) inset, 0 24px 48px -20px rgba(255,122,61,0.30);
        --cx-shadow-knob: 0 2px 8px rgba(0,0,0,0.6); --cx-obj-shadow: rgba(0,0,0,0.65);
      }
    </style>
  </head>
  <body style="margin:0; font-family:-apple-system,'Segoe UI',Inter,system-ui,sans-serif; background:#f4f6f9;">
    <CotizadorRedesign client:load />
  </body>
</html>

---
import '../styles/tokens.css';
import '../styles/price.css';
import { CotizadorRedesign } from '../components/services/CotizadorRedesign';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500&display=swap" rel="stylesheet" />
    <title>Cotizador de proyectos 3D — Alexander Woodcock</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Cotizador de proyectos 3D — Alexander Woodcock" />
    <meta property="og:description" content="Rango orientativo de costo y tiempo para tus proyectos 3D interactivos, en segundos." />
    <meta property="og:url" content="https://services.alexwoodcock.me/cotizador/" />
    <meta property="og:image" content="https://services.alexwoodcock.me/cotizador/og.jpg" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cotizador de proyectos 3D — Alexander Woodcock" />
    <meta name="twitter:description" content="Rango orientativo de costo y tiempo para tus proyectos 3D interactivos." />
    <meta name="twitter:image" content="https://services.alexwoodcock.me/cotizador/og.jpg" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Desarrollo 3D web en tiempo real",
      "provider": { "@type": "Person", "name": "Alexander Woodcock", "url": "https://alexwoodcock.me/" },
      "areaServed": "Worldwide",
      "serviceType": "Real-time 3D web development",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "COP",
        "lowPrice": "400000",
        "highPrice": "12610000",
        "offerCount": "28"
      }
    }
    </script>
    <meta name="description" content="Rango orientativo de costo y tiempo para tus proyectos 3D." />
    <script is:inline>
      /* Tema ANTES del primer pintado (evita flash blanco en modo oscuro). */
      try {
        var t = localStorage.getItem('cx-theme');
        if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.cxTheme = t;
        document.documentElement.style.background = t === 'dark' ? '#0b0b0f' : '#fbfbfd';
      } catch (e) { /* sin almacenamiento */ }
    </script>
    <style is:global>
      html { background: #fbfbfd; }
      html[data-cx-theme='dark'] { background: #0b0b0f; }
      /* Ciclo 10 — refuerzo del fondo SIN JS a nivel body: el inline claro es el
         default de SSR; en oscuro la regla !important lo corrige ANTES de que la
         isla hidrate (el inline pierde contra !important). */
      html[data-cx-theme='light'] body { background: #fbfbfd !important; }
      html[data-cx-theme='dark'] body { background: #0b0b0f !important; }
      /* Vars de tema a nivel documento: nunca dependen de la hidratación del isla */
      html[data-cx-theme='light'] {
        --cx-bg: #fbfbfd; --cx-card: rgba(255,255,255,0.85); --cx-card-solid: #ffffff;
        --cx-tile: #f5f5f7; --cx-text: #1d1d1f; --cx-muted: #86868b; --cx-faint: #aeaeb2;
        --cx-border: rgba(0,0,0,0.05); --cx-border-strong: rgba(0,0,0,0.10); --cx-soft: rgba(0,0,0,0.06);
        --cx-accent: #0071e3; --cx-accent-hover: #0077ed; --cx-accent-soft: #e8f0fe;
        --cx-accent-border: rgba(0,113,227,0.3);
        --cx-shadow-card: 0 2px 16px rgba(0,0,0,0.03); --cx-shadow-hover: 0 8px 24px rgba(0,0,0,0.06);
        --cx-shadow-knob: 0 2px 8px rgba(0,0,0,0.15); --cx-obj-shadow: rgba(29,29,31,0.14);
      }
      html[data-cx-theme='dark'] {
        --cx-bg: #0b0b0f; --cx-card: rgba(28,28,32,0.82); --cx-card-solid: #1c1c21;
        --cx-tile: #26262c; --cx-text: #f5f5f7; --cx-muted: #98989d; --cx-faint: #6e6e73;
        --cx-border: rgba(255,255,255,0.09); --cx-border-strong: rgba(255,255,255,0.16); --cx-soft: rgba(255,255,255,0.12);
        --cx-accent: #2997ff; --cx-accent-hover: #40a3ff; --cx-accent-soft: rgba(41,151,255,0.16);
        --cx-accent-border: rgba(41,151,255,0.4);
        --cx-shadow-card: 0 2px 16px rgba(0,0,0,0.45); --cx-shadow-hover: 0 8px 24px rgba(0,0,0,0.5);
        --cx-shadow-knob: 0 2px 8px rgba(0,0,0,0.6); --cx-obj-shadow: rgba(0,0,0,0.65);
      }
    </style>
  </head>
  <body style="margin:0; font-family:-apple-system,'Segoe UI',Inter,system-ui,sans-serif; background:#fbfbfd;">
    <CotizadorRedesign client:load />
  </body>
</html>
